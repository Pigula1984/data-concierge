# Copy to .env and fill in. Never commit .env.

# SQL Server connection (login agent_reader, see db/)
DC_SQL_SERVER=localhost
DC_SQL_DATABASE=AdventureWorks2025
DC_SQL_USER=agent_reader
DC_SQL_PASSWORD=
DC_SQL_DRIVER=ODBC Driver 18 for SQL Server
# Only for a local instance with a self-signed certificate
DC_SQL_TRUST_SERVER_CERTIFICATE=false

# Model (provider:model) and thinking effort
DC_MODEL=anthropic:claude-haiku-5-5
DC_EFFORT=medium
DC_STRICT_TOOLS=true
# Standard provider variable (no DC_ prefix); read into Settings
ANTHROPIC_API_KEY=

# Agent catalog (YAML)
DC_CATALOG_PATH=catalog/agent-procedures.yaml

# Limits
DC_MAX_AGENT_STEPS=10
DC_PROCEDURE_TIMEOUT_SECONDS=30
DC_PREVIEW_ROWS=10
DC_FULL_PREVIEW_MAX_ROWS=50
DC_MAX_RESPONSE_ROWS=10000
